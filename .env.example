# Use / for a custom domain, or /repository-name/ for GitHub project pages.
BASE_PATH=/

# npm run deploy uses an existing Git remote and a separate publishing branch.
DEPLOY_REMOTE=origin
DEPLOY_BRANCH=gh-pages

# Only VITE_* variables are exposed to browser code. Never put secrets here.
VITE_APP_NAME=Chess

# Cloudflare lobby WebSocket URL. Local development defaults to this address.
# Production: wss://chess-lobby.YOUR-SUBDOMAIN.workers.dev/lobby
VITE_LOBBY_URL=ws://localhost:8787/lobby
